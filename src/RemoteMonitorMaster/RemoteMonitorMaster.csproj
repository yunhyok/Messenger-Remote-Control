<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RemoteMonitorMaster</AssemblyName>
    <RootNamespace>RemoteMonitorMaster</RootNamespace>
    <Version>0.3.8</Version>
    <AssemblyVersion>0.3.8.0</AssemblyVersion>
    <FileVersion>0.3.8.0</FileVersion>
    <InformationalVersion>0.3.8</InformationalVersion>
    <Company>Messenger Remote Control</Company>
    <Product>Messenger Remote Control Master</Product>
    <AssemblyTitle>Messenger Remote Control Master</AssemblyTitle>
    <Description>Pinned Slave status client and continuous request-bound KI-Messenger status bridge</Description>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RemoteMonitorLink\*.cs" Link="Link\%(Filename)%(Extension)" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Accessibility" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
